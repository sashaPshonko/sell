# Скопируй: cp .env.example .env
# Токен: DevTools → Application → Cookies → playerok.com → token (только JWT, без "token=")

PLAYEROK_TOKEN=paste_jwt_here

# Твой id (опционально; иначе подтянется из viewer)
# PLAYEROK_USER_ID=1f14537a-fd9f-6250-679c-cde32ed6ba9a

# WebSocket → sellbot (npm start в sellbot/)
WS_URL=ws://127.0.0.1:8790
# WS_CLIENT=1
# WS_DISABLE=1 — без sellbot, только лог заказов

# Отправка сообщения в чат (сними из DevTools при ручной отправке «тест»)
# SEND_MESSAGE_OPERATION=createChatMessage
# SEND_MESSAGE_VARIABLES={"input":{"chatId":"CHAT_ID","text":"MESSAGE_TEXT"}}
# SEND_MESSAGE_MUTATION_FILE=./captures/send-message.graphql

# Интервал опроса, мс
POLL_MS=15000

# Окно до старта sell: оплаты за N мс до npm start тоже обрабатываем (по умолчанию 5 мин)
# DEAL_START_GRACE_MS=300000
# PROCESS_DEALS_AFTER=2026-05-25T12:00:00.000Z

# Persisted query hashes (из URL в DevTools → graphql?operationName=...)
USER_CHATS_HASH=999f86b7c94a4cb525ed5549d8f24d0d24036214f02a213e8fd7cefc742bbd58
# Сними при открытии чата, если chatMessages не заработает:
# CHAT_MESSAGES_HASH=

# После нажатия «Выполнил» в DevTools (x-gql-op + body):
# CONFIRM_DEAL_OPERATION=confirmItemDeal
# CONFIRM_DEAL_MUTATION_FILE=./captures/confirm-deal.graphql

# Отмена на PlayerOK при /cancel в чате (cURL отмены → npm run capture-cancel)
# AUTO_CANCEL_PLAYEROK=1
# CANCEL_DEAL_OPERATION=updateDeal
# CANCEL_DEAL_MUTATION_FILE=./captures/cancel-deal.graphql
# CANCEL_DEAL_STATUS=ROLLED_BACK
# CANCEL_DEAL_VARIABLES={"input":{"id":"DEAL_ID","status":"ROLLED_BACK"}}

# Перевыставление лота после оплаты (publishItem), по умолчанию через 10 с
# AUTO_PUBLISH_ITEM=0 — выключить
# PUBLISH_DELAY_MS=10000
# PUBLISH_PRIORITY_STATUSES=["1f00f21b-7768-62a0-296f-75a31ee8ce72"]
# PUBLISH_ITEM_OPERATION=publishItem
# PUBLISH_ITEM_MUTATION_FILE=./captures/publish-item.graphql
# PUBLISH_ITEM_GQL_PATH=/products/[slug]
# cURL publishItem → captures/paste-publish.curl → npm run capture-publish
