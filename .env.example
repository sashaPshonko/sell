# Три строки — из F12 → Application → Cookies → playerok.com

PLAYEROK_TOKEN=вставь_jwt_из_cookie_token
PLAYEROK_AUID=вставь_из_cookie_auid
PLAYEROK_DDG1=вставь_из_cookie___ddg1___

# PLAYEROK_COOKIES не нужен (старая длинная строка только мешала на VPS)

# botpodpopcorn: заголовок лота обязан начинаться с BPP и срока, как kk у валюты:
#   BPP 7д
#   BPP 30 дней
# LICENSE_URL=http://127.0.0.1:8787
# LICENSE_ADMIN_KEY=admin-ключ с license-сервера (не ключ покупателя)
# POPCORN_ITEM_MATCH=доп,слова,из,названия
# POPCORN_ITEM_IDS=uuid-лота
# POPCORN_DEFAULT_DAYS=7
# Папка Google Диска (exe + видео, не zip). В чат PlayerOK — только она, не /kit.
# POPCORN_DRIVE_URL=https://drive.google.com/drive/folders/...
