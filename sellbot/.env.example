# WebSocket для sell (poll.mjs подключается сюда)
WS_PORT=8790

# Тест без Telegram (пока нет токена)
SKIP_TELEGRAM=1
# TEST_MODE=1  — то же, что SKIP_TELEGRAM

# Тест выдачи без FunTime: сразу delivery_ok в sell (npm run start:mock)
# MOCK_DELIVERY=1
# MOCK_DELIVERY_MS=300

# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_PROXY=off
# TELEGRAM_AUTO_XRAY=off
# TELEGRAM_XRAY_CMD=bash /path/on/server/start-socks.sh

# Бот выдачи (bots/bot.json)
BOT_CONFIG=./bot.json

# Выдача валюты в чате сервера
# {nick} {amount} — amount в KK из заказа
PAY_TEMPLATE=/pay {nick} {amount}
# Сумма: либо PAY_SUFFIX=kk → 100kk, либо PAY_AMOUNT_MULTIPLIER=1000000 → монеты
# PAY_SUFFIX=kk
# PAY_AMOUNT_MULTIPLIER=1000000

# Цикл /pay до «[✔] Успешно!» в worker.mjs (константа PAY_SUCCESS_MARKERS)
# Пауза после каждого /pay (мс)
PAY_LOOP_WAIT_MS=2000

# Бот отключается через N мс после пустой очереди
IDLE_QUIT_MS=25000

PAY_OFFLINE_MARKERS=не в сети,оффлайн,не онлайн
PAY_INVALID_NICK_MARKERS=не найден,ник не найден,игрок не найден
PAY_FAIL_MARKERS=недостаточно,ошибка,отказано

# Таймаут одной выдачи (мс). При таймауте и очереди > 0 — сброс, покупателю /nick
DELIVER_TIMEOUT_MS=60000

# Проверка бан/капча на анархии, если нет заказов (не работает с MOCK_DELIVERY=1)
# HEALTH_CHECK_ENABLED=1
# HEALTH_CHECK_MS=3600000
# HEALTH_CHECK_FIRST_MS=120000
# HEALTH_CHECK_OBSERVE_MS=8000

# Баланс при проверке (/balance как в 4NAREK)
# BALANCE_MIN=1000000000
# BALANCE_WAIT_MS=15000
# BALANCE_CMD_WAIT_MS=2000

